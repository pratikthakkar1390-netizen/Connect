# Zernio API credentials — https://zernio.com/signup
# CONNECT uses this profile and WhatsApp account. Zernio allows one WhatsApp
# number per profile, so a vendor number belongs on a separate Zernio profile.
# Do not put the vendor account id here. Store it on vendors.zernio_whatsapp_account_id.
# Inbound still hits the single POST /webhooks/zernio; routing uses account.id.
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=
ZERNIO_WHATSAPP_ACCOUNT_ID=

# Webhook HMAC secret (choose a random string; used when registering webhook)
WEBHOOK_SECRET=

# Organizer phone in E.164 format (e.g. +15551234567)
ORGANIZER_PHONE=

# WhatsApp Business number used in shareable wa.me RSVP links (E.164, e.g. +15551234567).
# Digits only are used in the URL (no +). Required for click-to-chat RSVP links.
WHATSAPP_BUSINESS_PHONE=

# Comma-separated co-organizer phones (optional)
CO_ORGANIZER_PHONES=

# Server
PORT=3000
DATABASE_PATH=./data/rsvp.db

# WhatsApp template name (must be Meta-approved)
RSVP_TEMPLATE_NAME=event_rsvp_invite
RSVP_TEMPLATE_LANGUAGE=en_US

# Reminder template (set only after Meta approves event_rsvp_reminder)
# REMINDER_TEMPLATE_NAME=event_rsvp_reminder
# REMINDER_TEMPLATE_LANGUAGE=en_US

# Public URL for webhook registration (e.g. https://your-app.railway.app)
PUBLIC_WEBHOOK_URL=

# Public origin for short RSVP links. Defaults to https://connect.zip-bite.com
# PUBLIC_BASE_URL=https://connect.zip-bite.com

# Optional signing secret for web RSVP guest cookies. Falls back to WEBHOOK_SECRET.
# RSVP_GUEST_SECRET=

# Admin dashboard password (HTTP Basic Auth at /admin). Leave unset to disable.
ADMIN_PASSWORD=
